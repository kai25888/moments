# Tech Standards Branch Docker Build
# 为 tech-standards/main 分支定制的 Docker 镜像
# 包含技术规范文档和重构示例

FROM node:20.19.1-bookworm AS front
WORKDIR /app
RUN npm install -g pnpm@10.10.0
COPY front/package.json .
COPY front/pnpm-lock.yaml .
COPY front/pnpm-workspace.yaml .
RUN pnpm install
COPY front/. .
RUN pnpm run generate

FROM golang:1.23.3-alpine AS backend
ARG VERSION
ARG COMMIT_ID
ARG BRANCH=tech-standards/main
WORKDIR /app
RUN apk add --no-cache build-base tzdata
COPY backend/go.mod .
COPY backend/go.sum .
RUN go mod download
COPY backend/. .
COPY --from=front /app/.output/public /app/public
RUN go build -tags prod -ldflags="-s -w -X main.version=${VERSION} -X main.commitId=${COMMIT_ID} -X main.branch=${BRANCH}" -o /app/moments

FROM alpine
WORKDIR /app/data
RUN apk update --no-cache && apk add --no-cache ca-certificates tzdata
ENV PORT=3000
ENV TZ=Asia/Shanghai
ENV TECH_STANDARDS_VERSION=1.0.0
COPY --from=backend /app/moments /app/moments
RUN chmod +x /app/moments

# 添加技术规范文档到镜像中（用于参考）
RUN mkdir -p /app/docs
COPY TECH_IMPROVEMENT_PLAN.md /app/docs/
COPY CODING_STANDARDS.md /app/docs/
COPY CODE_REVIEW_CHECKLIST.md /app/docs/
COPY QUICK_START.md /app/docs/

# 添加重构示例代码
RUN mkdir -p /app/examples
COPY examples/refactored/ /app/examples/

EXPOSE 3000
CMD ["/app/moments"]
